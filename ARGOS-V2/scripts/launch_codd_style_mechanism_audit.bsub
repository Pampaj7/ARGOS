#!/usr/bin/env bash
#BSUB -J argos_codd_mechanism_audit
#BSUB -q p1
#BSUB -gpu "num=2:mode=shared"
#BSUB -n 48
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=192GB]"
#BSUB -W 24:00
#BSUB -o results/codd_style_fusion_mechanism_audit/lsf_%J.out
#BSUB -e results/codd_style_fusion_mechanism_audit/lsf_%J.err

# Stage 1 only: frozen post-hoc oracle/interpolation/streaming audit.  It
# cannot train a model and therefore cannot make a D7-dependent design choice.
set -euo pipefail

ROOT=/dtu/p1/leopam/ARGOS/ARGOS-V2
PYTHON=/dtu/p1/leopam/ARGOS/.miniconda/envs/argos/bin/python
OUT=$ROOT/results/codd_style_fusion_mechanism_audit
cd "$ROOT"
mkdir -p "$OUT"

run_seed() {
  local seed=$1 gpu=$2
  CUDA_VISIBLE_DEVICES="$gpu" PYTHONPATH="$ROOT" "$PYTHON" \
    scripts/run_codd_style_fusion_mechanism_audit.py --mode audit --seed "$seed" \
    --device cuda:0 --workers 20 --preload-workers 20 --output-root "$OUT"
}

run_seed 0 0 & pid0=$!
run_seed 1 1 & pid1=$!
wait "$pid0"
wait "$pid1"
run_seed 2 0
PYTHONPATH="$ROOT" "$PYTHON" scripts/run_codd_style_fusion_mechanism_audit.py \
  --mode summarize --output-root "$OUT"
